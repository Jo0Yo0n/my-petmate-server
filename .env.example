# Copy this file to .env before starting the local PostgreSQL container.
# Spring does not load this file automatically. For the app's default local
# datasource settings, start it with SPRING_PROFILES_ACTIVE=local.
# If you change these values, configure the same values in the app run profile.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_petmate
DB_USERNAME=my_petmate
DB_PASSWORD=my_petmate
